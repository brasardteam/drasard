# Required for the Vercel contact-form endpoint.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: defaults to contact@drasard.agency
CONTACT_TO_EMAIL=contact@drasard.agency

# Use a sender address from a domain verified in Resend.
# During initial testing Resend may allow onboarding@resend.dev for the account owner.
RESEND_FROM_EMAIL=Drasard Website <onboarding@resend.dev>
